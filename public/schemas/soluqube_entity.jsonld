    {
      "@type": "FAQPage",
      "@id": "https://soluqube.com/asc-606#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Why can LLMs not calculate relative standalone selling price (SSP) allocations reliably?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Frontier LLMs (GPT-4, Claude, Gemini) are probabilistic autoregressive token generators that suffer from arithmetic hallucinations and rounding drift when performing multi-variable division over fractional contract terms. Soluqube uses deterministic integer (BigInt) arithmetic at 10^6 scale, rounded to cents, with terminal-period remainder absorption, so schedules tie to the contract value."
          }
        },
        {
          "@type": "Question",
          "name": "How does Soluqube guarantee zero rounding drift across multi-year ASC 606 contracts?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Soluqube uses integer (BigInt) fixed-point arithmetic at 10^6 scale, rounded to cents, rather than standard IEEE-754 64-bit binary floating-point numbers. Any residual rounding remainder from non-terminating divisions is absorbed into the terminal period of the performance obligation, so the schedule ties to the contract value."
          }
        },
        {
          "@type": "Question",
          "name": "How does Soluqube ground revenue performance obligations to contract PDFs for external auditors?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Soluqube normalizes multi-DPI PDF documents to a canonical 1000x1000 coordinate grid, linking every ASC 606 performance obligation directly to bounding box coordinates (x0, y0, x1, y1, page) with extracted clause text and SHA-256 content hashes to support audit documentation."
          }
        },
        {
          "@type": "Question",
          "name": "How does Soluqube handle cross-border Indian GST under Ind AS 115?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Soluqube isolates statutory 18% GST (CGST/SGST/IGST) into dedicated balance sheet liability accounts, ensuring statutory indirect taxes never pollute top-line ratable revenue schedules under Schedule III of the Indian Companies Act 2013."
          }
        }
      ]
    }
